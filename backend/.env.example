# Backend environment — copy to backend/.env (docker compose reads it too).
# Async SQLAlchemy URL: the Supabase connection string (Settings -> Database) with
# its scheme changed to postgresql+asyncpg://. A local Postgres works for
# `uvicorn` on the host, but not under docker compose, where localhost is the
# backend container itself.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ultimate_tracker
# JWKS endpoint of your Supabase project (Settings -> API -> JWT Keys):
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional, checked only when set: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Signing algorithms to accept, as a JSON list. ES256 unless the project's JWT
# signing keys are RSA, in which case use ["RS256"].
SUPABASE_JWT_ALGORITHMS=["ES256"]
CORS_ORIGINS=["http://localhost:3000"]
# Shared secret for the background-job endpoints (POST /api/v1/tasks/...). Empty
# disables them. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TASK_SECRET=
# Days before a subscription charge (or trial end) the reminder is sent.
SUBSCRIPTION_REMINDER_LEAD_DAYS=3
# development (the default) or test: readable console logs. Anything else is a
# deployment — set ENVIRONMENT=production on Render for JSON logs.
ENVIRONMENT=development
