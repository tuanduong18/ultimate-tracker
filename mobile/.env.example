# Copy to mobile/.env for local development; Expo loads it on `npm start`.
#
# Every EXPO_PUBLIC_* value is compiled into the app, and anyone holding the APK can read it —
# public by design, like the frontend's NEXT_PUBLIC_*. Never put a secret here: secrets live
# on the backend (Render), and the app holds none.
#
# EAS cloud builds do not see this file (it is gitignored, so it is never uploaded). Set the
# same names as EAS environment variables for any build that bakes in its own bundle:
#   npx eas-cli env:create --name EXPO_PUBLIC_SUPABASE_URL --value ... --environment preview

# Supabase project settings → API. The anon key is the public one, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The FastAPI backend. On a phone, localhost is the phone itself: use the computer's LAN
# address (http://192.168.x.x:8000) for a local backend, or the Render URL.
EXPO_PUBLIC_API_BASE_URL=
