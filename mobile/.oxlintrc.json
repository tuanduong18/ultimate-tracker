{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The rule set eslint-config-expo ran, carried over with @oxlint/migrate.
  // Categories are off so only the rules listed here run, and an Oxlint upgrade
  // can't switch new ones on unannounced.
  //
  // Not carried over: eslint-plugin-expo's three rules (env-var destructuring,
  // dynamic env-var access, DOM-component exports). The plugin depends on
  // ESLint 9 and typescript-eslint, which would bring back the TypeScript cap
  // this switch removed. Read EXPO_PUBLIC_* as `process.env.EXPO_PUBLIC_X`
  // literally, as the frontend does with NEXT_PUBLIC_*.
  "plugins": ["import", "react"],
  "categories": { "correctness": "off" },
  "env": { "builtin": true, "es2022": true, "browser": true, "node": true },
  "globals": { "__DEV__": "readonly", "ErrorUtils": "readonly" },
  "ignorePatterns": [".expo/", "dist/", "android/", "ios/", "coverage/", "expo-env.d.ts"],
  "rules": {
    // ESLint core
    "eqeqeq": ["warn", "smart"],
    "no-dupe-class-members": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "warn",
    "no-empty-pattern": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-redeclare": "warn",
    "no-unreachable": "warn",
    "no-unsafe-negation": "warn",
    "no-unused-expressions": ["warn", { "allowShortCircuit": true, "enforceForJSX": true }],
    "no-unused-labels": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true,
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-var": "error",
    "no-with": "warn",
    "unicode-bom": ["warn", "never"],
    "use-isnan": "error",
    "valid-typeof": "error",

    // eslint-plugin-import
    "import/first": "warn",
    "import/namespace": "error",
    "import/no-duplicates": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",

    // eslint-plugin-react
    "react/display-name": "error",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-this-in-sfc": "warn",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "warn",

    // eslint-plugin-react-hooks 7, including its React Compiler rules
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "warn",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "warn",
    "react/use-memo": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "plugins": ["typescript"],
      "rules": {
        "no-unused-vars": [
          "warn",
          { "vars": "all", "args": "none", "ignoreRestSiblings": true, "caughtErrors": "all" }
        ],
        "no-useless-constructor": "warn",
        "typescript/array-type": ["warn", { "default": "array" }],
        "typescript/consistent-type-assertions": [
          "warn",
          { "assertionStyle": "as", "objectLiteralTypeAssertions": "allow" }
        ],
        "typescript/no-empty-object-type": "warn",
        "typescript/no-extra-non-null-assertion": "warn",
        "typescript/no-require-imports": [
          "warn",
          {
            "allow": [
              "\\.(aac|aiff|avif|bmp|caf|db|gif|heic|html|jpeg|jpg|json|m4a|m4v|mov|mp3|mp4|mpeg|mpg|otf|pdf|png|psd|svg|ttf|wav|webm|webp|xml|yaml|yml|zip)$"
            ]
          }
        ],
        "typescript/no-wrapper-object-types": "warn"
      }
    }
  ]
}
